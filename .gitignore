.Rproj.user
.Rproj.user/
.Rhistory
.RData
# Lock files that Office and PDF viewers leave next to an open document
~$*

# Secrets: keys live only in the user-level .Renviron
.Renviron

# Data cache and pipeline store (tens of GB, rebuilt by the pipeline)
data-raw/cache/*
!data-raw/cache/.gitkeep
_targets/
# Versioned pins board (all layers) and data-quality logs, rebuilt by the pipeline
data/
logs/
*.parquet
*.duckdb
*.duckdb.wal

# Rendered report: rebuilt by targets; the submission copy is force-added at CP4
inst/report/*.html

# Literature PDFs: copyrighted, kept locally only
papers/

# Quarto work files
.quarto/
report/*_files/
memo/*_files/

/.quarto/
**/*.quarto_ipynb
